{
  "name": "hackmemo",
  "version": "0.1.0",
  "description": "Personal hackathon memory assistant (WhatsApp + Web) built on Walrus Memory, for the Walrus Session 8 hackathon.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "report:memory": "tsx scripts/memory-report.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@hapi/boom": "^10.0.1",
    "@mysten-incubation/memwal": "^0.1.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@6.7.24": true,
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
